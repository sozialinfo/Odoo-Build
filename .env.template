# Odoo-Build Environment Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# CORE SETTINGS (Required)
# ============================================================================

# Odoo version to use
ODOO_REVISION=16.0

# Path to addon directories (mounted into container)
ODOO_ADDONS_PATH=/mnt/addons/,/mnt/oca/,/mnt/enterprise,/mnt/themes/

# Database name (defaults to Odoo version)
ODOO_DATABASE=16.0

# ============================================================================
# DOCKER SETTINGS
# ============================================================================

# Container registry and image
CONTAINER_REGISTRY=mintsystem
CONTAINER_TAG=odoo:16.0

# PostgreSQL settings
POSTGRES_IMAGE=postgres:14-alpine
POSTGRES_PORT=5432
POSTGRES_SSL=off
PGSSLMODE=prefer

# Odoo web interface port
ODOO_PORT=8069

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable demo data for development
ODOO_INIT_DEMO_DATA=True

# Language setting
ODOO_LANGUAGE=de_CH

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Browser auto-open on start
BROWSER_OPEN=true

# ============================================================================
# EMAIL SETTINGS (Local Development)
# ============================================================================

# SMTP settings (using local mailpit for development)
SMTP_SERVER=mailpit
SMTP_PORT=1025
SMTP_SSL=False
SMTP_USER=
SMTP_PASSWORD=

# Email addresses
EMAIL_FROM=info@yourcompany.com
MAIL_ALIAS_DOMAIN=yourcompany.com
MAIL_BOUNCE_ALIAS=
MAIL_CATCHALL_ALIAS=
MAIL_CATCHALL_DOMAIN=
MAIL_DEFAULT_FROM=

# ============================================================================
# ADVANCED SETTINGS (Optional - leave empty for defaults)
# ============================================================================

# Git integration (for automated addon management)
GIT_SSH_PUBLIC_KEY=
GIT_SSH_PRIVATE_KEY=
GITHUB_USERNAME=
GITHUB_PERSONAL_ACCESS_TOKEN=
ADDONS_GIT_REPOS=

# Odoo advanced configuration
ODOO_INIT_LOGIN=
ODOO_INIT_PASSWORD=
ODOO_INIT_LANG=
ODOO_INIT_ADDONS=
ENVIRONMENT=
PYTHON_INSTALL=
SERVER_WIDE_MODULES=
SESSION_DB_URI=
PROXY_MODE=
LIST_DB=
ADMIN_PASSWD=
DBFILTER=
WORKERS=
LIMIT_REQUEST=
LIMIT_TIME_CPU=
LIMIT_TIME_REAL=
MODULE_AUTO_INSTALL_DISABLED=
AUTO_UPDATE_MODULES=
AUTO_UPDATE_TRANSLATIONS=

# Email advanced settings
ODOO_MAIL_IMAP_HOST=
ODOO_MAIL_IMAP_PORT=
ODOO_MAIL_IMAP_SSL=
ODOO_MAIL_USERNAME=
ODOO_MAIL_PASSWORD=
ODOO_MAIL_SMTP_HOST=
ODOO_MAIL_SMTP_PORT=
ODOO_MAIL_SMTP_ENCRYPTION=
ODOO_MAIL_SMTP_FROM_FILTER=

# Testing settings
TEST_ADDONS_DIR=
TEST_INCLUDE=
TEST_EXCLUDE=

# Mail aliases
MAIL_ALIASES=